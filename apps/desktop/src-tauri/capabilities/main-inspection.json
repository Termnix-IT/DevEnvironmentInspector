{
  "identifier": "main-inspection",
  "description": "ローカルのmain画面に、既知カタログの検出、ユーザーが選択したJSON保存、ウィンドウ操作を許可する",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-get-catalog", "allow-get-snapshot", "allow-scan-environment", "allow-export-snapshot",
    "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-close",
    "core:window:allow-start-dragging", "core:window:allow-internal-toggle-maximize"
  ]
}
